<?xml version="1.0" encoding="UTF-8"?>
<!-- Workshop seed POM — Validated tier. JAR is real Apache Commons Lang 3.14.0 (ASL 2.0). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.commons</groupId>
  <artifactId>commons-lang3</artifactId>
  <version>3.14.0</version>
  <packaging>jar</packaging>
  <name>commons-lang3 (Lightwell workshop validated seed)</name>
  <description>Compile-capable Validated seed for Spring Boot PoC clean verify (Module 2 consumption experiment).</description>
  <properties>
    <lightwell.tier>validated</lightwell.tier>
    <lightwell.seed.kind>compile-capable</lightwell.seed.kind>
  </properties>
</project>
