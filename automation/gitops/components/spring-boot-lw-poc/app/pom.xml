<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.redhat.lightwell.workshop</groupId>
  <artifactId>spring-boot-lw-poc</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>spring-boot-lw-poc</name>
  <description>Lightwell TSSC workshop — Spring Boot / Java 21 Maven PoC (Validated + Remediated)</description>

  <properties>
    <java.version>21</java.version>
    <!--
      Dual dependency streams (field PoV pattern):
      - Default / lightwell-validated: upstream-parity version from Validated tier
      - lightwell-remediated-pins: exact-version .rhlw-0000X pin from Remediated tier
      The .rhlw-* artifact resolves from Lightwell Network (or seeded Nexus), not Maven Central.
    -->
    <commons.lang3.version>3.18.0</commons.lang3.version>
    <springdoc.version>2.6.0</springdoc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- Demo library whose version can be flipped to a remediated .rhlw-* pin -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${commons.lang3.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Active development against Lightwell Validated (or Maven Central for the default version) -->
    <profile>
      <id>lightwell-validated</id>
      <properties>
        <commons.lang3.version>3.14.0</commons.lang3.version>
        <lightwell.stream>validated</lightwell.stream>
      </properties>
    </profile>
    <!--
      Production-style exact-version remediation.
      Example pin shape matches LWN: 5.3.18.rhlw-00003 (see lightwell-repo sample OSV).
      Replace commons.lang3.version with a real remediated coordinate when using seeded/proxy Nexus.
    -->
    <profile>
      <id>lightwell-remediated-pins</id>
      <properties>
        <!-- Workshop example — resolve from lightwell-java-remediated when available -->
        <commons.lang3.version>3.14.0.rhlw-00001</commons.lang3.version>
        <lightwell.stream>remediated</lightwell.stream>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
