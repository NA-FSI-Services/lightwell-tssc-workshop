# Copy to claim.env (gitignored) and fill from the RHDP OpenShift claim email.
# Never commit claim.env, CA files, tokens, or passwords.

# --- Required (API / deployer) ---
API_URL='https://api.CLUSTER_ID.BASE.opentlc.com:6443'
DEPLOYER_DOMAIN='apps.CLUSTER_ID.BASE.opentlc.com'

# Prefer the cluster-admin service account token from the email for first login
OC_TOKEN='REPLACE_WITH_CLUSTER_ADMIN_TOKEN'

# Path to the API CA PEM saved from the email (relative to repo root or absolute)
OC_CA_FILE='dev-cluster/cluster.ca.crt'

# --- Optional documentation / ops ---
CONSOLE_URL='https://console-openshift-console.apps.CLUSTER_ID.BASE.opentlc.com'
BASTION_HOST='bastion.CLUSTER_ID.BASE.opentlc.com'
BASTION_USER='lab-user'
# BASTION_PASSWORD — do not put in this file if avoidable; use SSH agent / prompt
KUBEADMIN_USER='kubeadmin'
# KUBEADMIN_PASSWORD — console only; keep out of scripts when possible
AWS_CONSOLE_URL=''

# --- HTPasswd lab admin (dev-cluster QA) ---
# After token login + bootstrap, run ./scripts/dev-cluster-htpasswd.sh then switch mode:
#   OC_LOGIN_MODE=password
# Set a local-only password here — never commit claim.env.
HTPASSWD_ADMIN_USER='admin'
HTPASSWD_ADMIN_PASSWORD='CHANGE_ME'
HTPASSWD_IDP_NAME='htpasswd_provider'
HTPASSWD_SECRET_NAME='htpasswd-secret'
# token | password — use token for first bootstrap; password after htpasswd script
OC_LOGIN_MODE='token'

# --- Workshop GitOps defaults ---
GIT_REPO='https://github.com/NA-FSI-Services/lightwell-tssc-workshop.git'
GIT_REVISION='main'
ANTORA_PLAYBOOK='site-ci.yml'

# Bootstrap Helm release
BOOTSTRAP_RELEASE='lightwell-dev-bootstrap'
BOOTSTRAP_NAMESPACE='openshift-gitops'
INSTALL_GITOPS_OPERATOR='true'

# --- Claim capacity / Module 1 defaults (bootstrap.sh) ---
# Bare OCP-on-AWS claims often ship MachineSets at replicas=0 (single overloaded node).
SCALE_WORKERS='true'
WORKER_REPLICAS='2'
WAIT_WORKERS_SECONDS='900'
# Enable wave-20 artifact manager for Module 1 ConfigMap / OSV exercises
ENABLE_LIGHTWELL_REPO='true'
# Enable wave-15 Gitea with a single workshop learner (user1 + random password)
ENABLE_GITEA='true'
SHOWROOM_LAB_CLUSTER_ACCESS='true'
ARGOCD_GRANT_CLUSTER_ADMIN='true'

# --- Module 4–5 TSSC stack (bootstrap → root-app components.*.enabled) ---
# Convenience: ENABLE_TSSC_STACK=true turns on keycloak + pipelines + rhtas + rhtpa + rhacs.
# Or set individuals. Requires workers sized for operators (see sizing table in DEV-CLUSTER-BOOTSTRAP.md).
ENABLE_TSSC_STACK='false'
ENABLE_KEYCLOAK='false'
ENABLE_PIPELINES='false'
ENABLE_RHTAS='false'
ENABLE_RHTPA='false'
ENABLE_RHACS='false'

# --- Workshop learner (Gitea / Module 5 QA) ---
# Bootstrap generates WORKSHOP_USER_PASSWORD when empty and echoes it at the end.
# Only this one user is seeded — do not add a second student for instruction tests.
# See docs/DEV-CLUSTER-WORKSHOP-USER.md (agents: capture the printed password).
WORKSHOP_USER='user1'
WORKSHOP_USER_PASSWORD=''
# WORKSHOP_USER_EMAIL='user1@workshop.local'
# WORKSHOP_USER_FULL_NAME='Workshop User 1'
