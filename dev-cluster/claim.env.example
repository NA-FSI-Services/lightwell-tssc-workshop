# Copy to claim.env (gitignored) and fill from the RHDP OpenShift claim email.
# Never commit claim.env, CA files, tokens, or passwords.

# --- Required (API / deployer) ---
API_URL='https://api.CLUSTER_ID.BASE.opentlc.com:6443'
DEPLOYER_DOMAIN='apps.CLUSTER_ID.BASE.opentlc.com'

# Prefer the cluster-admin service account token from the email
OC_TOKEN='REPLACE_WITH_CLUSTER_ADMIN_TOKEN'

# Path to the API CA PEM saved from the email (relative to repo root or absolute)
OC_CA_FILE='dev-cluster/cluster.ca.crt'

# --- Optional documentation / ops ---
CONSOLE_URL='https://console-openshift-console.apps.CLUSTER_ID.BASE.opentlc.com'
BASTION_HOST='bastion.CLUSTER_ID.BASE.opentlc.com'
BASTION_USER='lab-user'
# BASTION_PASSWORD — do not put in this file if avoidable; use SSH agent / prompt
KUBEADMIN_USER='kubeadmin'
# KUBEADMIN_PASSWORD — console only; keep out of scripts when possible
AWS_CONSOLE_URL=''

# --- Workshop GitOps defaults ---
GIT_REPO='https://github.com/NA-FSI-Services/lightwell-tssc-workshop.git'
GIT_REVISION='main'
ANTORA_PLAYBOOK='site-ci.yml'

# Bootstrap Helm release
BOOTSTRAP_RELEASE='lightwell-dev-bootstrap'
BOOTSTRAP_NAMESPACE='openshift-gitops'
INSTALL_GITOPS_OPERATOR='true'
